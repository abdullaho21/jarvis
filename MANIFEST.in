include LICENSE README.md CONTRIBUTING.md SECURITY.md pyproject.toml
include run-jarvis run-murmur
recursive-include src/murmur *.py *.css *.conf
recursive-include tests *.py
recursive-include scripts *.py
recursive-include native/voice-worker *.rs Cargo.toml Cargo.lock
recursive-include native/gtcrn-denoiser *.rs Cargo.toml Cargo.lock
recursive-include native/whisper-recognizer *.rs Cargo.toml Cargo.lock
prune native/voice-worker/target
prune native/gtcrn-denoiser/target
prune native/whisper-recognizer/target
recursive-include examples *.json *.jsonc *.conf *.lua
recursive-include docs *.md *.json *.png
recursive-include .github *.yml *.md
global-exclude *.py[cod] __pycache__
