include LICENSE README.md CONTRIBUTING.md SECURITY.md pyproject.toml
include run-jarvis run-murmur
recursive-include src/murmur *.py *.css *.conf
recursive-include tests *.py
recursive-include scripts *.py
recursive-include native/voice-worker *.rs Cargo.toml Cargo.lock
recursive-include native/gtcrn-denoiser *.rs Cargo.toml Cargo.lock
recursive-include native/whisper-recognizer *.rs Cargo.toml Cargo.lock
recursive-include native/controller *.rs *.json Cargo.toml Cargo.lock
recursive-include native/cli *.rs *.bz2 Cargo.toml Cargo.lock
prune native/voice-worker/target
prune native/gtcrn-denoiser/target
prune native/whisper-recognizer/target
prune native/controller/target
prune native/cli/target
recursive-include examples *.json *.jsonc *.conf *.lua
recursive-include docs *.md *.json *.png
recursive-include .github *.yml *.md
recursive-include packaging *.py *.spec *.manifest *.nsi *.json *.txt PKGBUILD
recursive-include packaging/windows/licenses *
global-exclude *.py[cod] __pycache__

recursive-include native/command-phrases *.rs Cargo.toml Cargo.lock
prune native/command-phrases/target
recursive-include native/replay-store *.rs Cargo.toml Cargo.lock
prune native/replay-store/target
recursive-include native/kws-probe *.rs *.c *.h *.md LICENSE Cargo.toml Cargo.lock
prune native/kws-probe/target
