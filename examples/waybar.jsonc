// Add the module name to your own Waybar modules list; no automatic config edits.
// The command stays running: it shows "off" while the service is stopped and
// reconnects by itself, so restart-interval is only a fallback.
{
  "custom/murmur": {
    "exec": "/absolute/path/to/checkout/.venv/bin/jarvis waybar",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "/absolute/path/to/checkout/.venv/bin/jarvis ui",
    "on-click-right": "/absolute/path/to/checkout/.venv/bin/jarvis mute"
  }
}
